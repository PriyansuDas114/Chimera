{
  "name": "multi-agent-engine",
  "version": "0.1.0",
  "description": "Local-first terminal-driven Multi-Agent Orchestration Engine",
  "type": "module",
  "bin": {
    "chimera": "./bin/chimera.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "dev:run": "tsx src/cli/index.ts run",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "health": "tsx src/cli/index.ts health",
    "models": "tsx src/cli/index.ts models",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "@langchain/community": "^0.3.0",
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/ollama": "^0.1.0",
    "@langchain/openai": "^0.6.17",
    "apache-arrow": "^14.0.2",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "vectordb": "^0.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
