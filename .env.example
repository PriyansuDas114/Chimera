# ─── Provider Selection ───────────────────────────────────────────────────────
# Set to "openrouter" for 200+ cloud models, or "ollama" for local models (default)
CHIMERA_PROVIDER=ollama

# ─── OpenRouter Configuration ─────────────────────────────────────────────────
# Get a free API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# OpenRouter model overrides (optional — defaults set in config/index.ts)
# Model format: "provider/model-name"
# Examples: openai/gpt-4o, anthropic/claude-3-5-sonnet, google/gemini-2.0-flash-001
OR_SUPERVISOR_MODEL=google/gemini-2.0-flash-001
OR_CODER_MODEL=anthropic/claude-sonnet-4-5
OR_AUDITOR_MODEL=anthropic/claude-sonnet-4-5
OR_RESEARCHER_MODEL=google/gemini-2.0-flash-001
OR_QA_MODEL=google/gemini-2.0-flash-001

# ─── Ollama Configuration ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_SUPERVISOR_MODEL=llama3.1
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_AUDITOR_MODEL=llama3.1
OLLAMA_RESEARCHER_MODEL=llama3.1
OLLAMA_QA_MODEL=llama3.1

# ─── Engine Configuration ─────────────────────────────────────────────────────
SESSION_DB_PATH=./data/sessions
VECTOR_DB_PATH=./data/vectors
LOG_LEVEL=info
MAX_GRAPH_STEPS=50
MAX_TOOL_CALLS_PER_TURN=5